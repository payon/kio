                "border": "2px solid @borderColor"
              },
              "&:hover": {
                "box-shadow": "5px 5px 0 0 @borderColor !important",
                "background-color": "@bgCardHover"
              }
            },
            ".flex-column .iconfont-wrapper": {
              "text-align": "left",
              "margin-bottom": "16px",
              ".mbr-iconfont": {
                "color": "@iconColor"
              }
            },
            ".card-text": {
              "margin-bottom": "2rem",
              "text-align": "left",
              "color": "#000000"
            },
            ".button-align": {
              "margin-top": "36px",
              "text-align": "center"
            },
            ".mbr-section-btn": {
              "width": "auto",
              "display": "inline-block"
            },
            "img": {
              "border-radius": "10%",
              "height": "65px",
              "width": "auto",
              "margin": "0"
            },
            ".flex-column .mbr-iconfont::before": {
              "font-size": "25px"
            },
            ".card-title": {
              "margin-bottom": "4px",
              "padding": "0",
              "margin-left": "-15px"
            },
            ".col-12.col-md-6.col-lg-4": {
              "margin-top": "30px"
            },
            ".col-12.col-md-6.col-lg-4:nth-child(1)": {
              "margin-top": "0px"
            },
            ".col-12.col-md-6.col-lg-4:nth-child(2)": {
              "margin-top": "0px"
            },
            ".col-12.col-md-6.col-lg-4:nth-child(3)": {
              "margin-top": "0px"
            },
            "@media (max-width: 992px)": {
              ".col-12.col-md-6.col-lg-4:nth-child(3)": {
                "margin-top": "30px"
              }
            },
            "@media (max-width: 768px)": {
              ".col-12.col-md-6.col-lg-4:nth-child(2)": {
                "margin-top": "30px"
              }
            },
            ".align": {
              "display": "flex",
              "align-items": "center"
            },
            ".mbr-section-title": {
              "margin-bottom": "56px",
              "color": "#000000",
              "text-align": "center"
            },
            ".btn": {
              "margin-top": "20px",
              "padding": "1rem 2rem"
            },
            ".card-text, .iconfont-wrapper": {
              "color": "#000000"
            },
            ".item-title": {
              "color": "#000000",
              "margin-bottom": "1rem"
            }
          },
          "_name": "people01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people1\" group=\"People\">\n  <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n    <header>Card</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitleCard\" checked>\n    <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n    <input type=\"color\" title=\"Icons Color\" name=\"iconColor\" value=\"#000000\" selected condition=\"showIcons\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Role\" name=\"showDesc\" checked>\n    <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n    <input type=\"color\" title=\"BG\" name=\"bgCard\" value=\"#fffff5\" selected>\n    <input type=\"color\" title=\"BG Hover\" name=\"bgCardHover\" value=\"#bff747\" selected>\n    <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n    <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#000000\" selected condition=\"showBorder\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fffff5\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n  </mbr-parameters>\n\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n  </div>\n\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Clients are always <br>satisfied with us</b>\n    </h3>\n    <div class=\"row row g-4\">\n      <div class=\"col-12 col-md-6 features-image item active\">\n        <div class=\"d-flex flex-column h-100 item-wrapper\">\n          <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n          </div>\n          <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCard\" data-app-selector=\".item-title\"><b>Super customer service!</b></h4>\n          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text, .iconfont-wrapper\" mbr-if=\"showText\">Excellent customer service and I was\n            really impressed and happy with my purchase\n            especially as it was a last minute order which got to me in time, and when it arrived I was very happy with\n            the design and size and so was the recipient.</h5>\n          <div class=\"row mt-auto\">\n            <div class=\"wrap-img col-auto\">\n              <img src=\"@PROJECT_PATH@/assets/images/team7.webp\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n            </div>\n            <div class=\"col align\">\n              <div>\n                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-title\" mbr-if=\"showName\">\n                  <b>Sophie Gordon</b>\n                </h5>\n                <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-subtitle\" mbr-if=\"showDesc\">Posted on YouTube</h5>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-12 col-md-6 features-image item\">\n        <div class=\"d-flex flex-column h-100 item-wrapper\">\n          <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n          </div>\n          <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCard\" data-app-selector=\".item-title\"><b>Exceptional creativity and vision</b></h4>\n          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text, .iconfont-wrapper\" mbr-if=\"showText\">Working with Pixcels Themes was a\n            game-changer for our brand. Their exceptional creativity\n            &amp; vision breathed new life into our visual. The logo they designed perfectly captures our essence &amp;\n            has become instantly recognizable. We couldn't be happier with the results!</h5>\n          <div class=\"row mt-auto\">\n            <div class=\"wrap-img col-auto\">\n              <img src=\"@PROJECT_PATH@/assets/images/team9.webp\" alt data-slide-to=\"1\" data-bs-slide-to=\"1\">\n            </div>\n            <div class=\"col align\">\n              <div>\n                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-title\" mbr-if=\"showName\">\n                  <b>Richard King</b>\n                </h5>\n                <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-subtitle\" mbr-if=\"showDesc\">Posted on Facebook</h5>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"col-12 col-md-6 features-image item\">\n        <div class=\"d-flex flex-column h-100 item-wrapper\">\n          <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n          </div>\n          <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCard\" data-app-selector=\".item-title\"><b>Innovative and professional</b></h4>\n          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text, .iconfont-wrapper\" mbr-if=\"showText\">I can't say enough good things about\n            them. Their team is not only incredibly talented but\n            also highly professional. They listened to our ideas and brought them to life in ways we couldn't have\n            imagined. Their innovative approach and dedication to our project.</h5>\n          <div class=\"row mt-auto\">\n            <div class=\"wrap-img col-auto\">\n              <img src=\"@PROJECT_PATH@/assets/images/team8.webp\" alt>\n            </div>\n            <div class=\"col align\">\n              <div>\n                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-title\" mbr-if=\"showName\">\n                  <b>Joy Shelton</b>\n                </h5>\n                <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-subtitle\" mbr-if=\"showDesc\">Posted on Twitch</h5>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-12 col-md-6 features-image item\">\n        <div class=\"d-flex flex-column h-100 item-wrapper\">\n          <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n            <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-star mobi-mbri\"></span>\n          </div>\n          <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCard\" data-app-selector=\".item-title\"><b>Transformed our brand</b></h4>\n          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text, .iconfont-wrapper\" mbr-if=\"showText\">Our partnership with Pixcels Themes\n            transformed our brand from ordinary to extraordinary.\n            Their branding expertise and meticulous design work elevated our marketing materials to a whole new level.\n            Our customers have taken notice, and boost in brand recognition.</h5>\n          <div class=\"row mt-auto\">\n            <div class=\"wrap-img col-auto\">\n              <img src=\"@PROJECT_PATH@/assets/images/team10.webp\" alt>\n            </div>\n            <div class=\"col align\">\n              <div>\n                <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-title\" mbr-if=\"showName\">\n                  <b>Paul Barret</b>\n                </h5>\n                <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-subtitle\" mbr-if=\"showDesc\">Posted on YouTube</h5>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"button-align\">\n      <div class=\"mbr-section-btn\" mbr-if=\"showButton\" data-app-selector=\".mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Contact Us</a>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "uw6dY6MyhZ",
