        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "@min-height": "90px",
            "@min-height-small": "@min-height / 2",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".loop-container": {
              ".item": {
                "min-height": "auto",
                "font-weight": "700"
              }
            },
            ".item": {
              "color": "@contentColor",
              "min-height": "@min-height",
              "@media (max-width: 768px)": {
                "min-height": "@min-height-small"
              }
            }
          },
          "_name": "gallery01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gellery01 range5\" group=\"Gallery &amp; Slider\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n        <header>Animated Text Settings</header>\n        <select title=\"Font style\" name=\"linesTitle\">\n            <option value=\"title1\">Title 1</option>\n            <option value=\"title2\">Title 2</option>\n            <option value=\"title3\" selected=\"\">Title 3</option>\n            <option value=\"text\">Text</option>\n        </select>\n        <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\" inline=\"\" name=\"animatedLine1\" value=\"Let's create new experiences&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;✽&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Let's create new experiences&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;✽&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Let's create new experiences&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;✽&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Let's create new experiences&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;✽&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\">\n        <input type=\"range\" inline=\"\" title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.01\">\n        <select title=\"Direction\" name=\"direction\">\n            <option value=\"-1\" selected=\"\">Left</option>\n            <option value=\"1\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Content Color\" value=\"#bff747\" name=\"contentColor\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fffff5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container-fluid\">\n        <div class=\"loop-container\">\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n                  'display-5':linesTitle=='title3', 'display-7':linesTitle=='text'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n            </div>\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n                  'display-5':linesTitle=='title3', 'display-7':linesTitle=='text'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n                Let's create new experiences&nbsp;&nbsp; ✽ &nbsp;&nbsp; Let's create new experiences&nbsp;&nbsp; ✽\n                &nbsp;&nbsp;\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6dZeSVAb",
          "_anchor": "gallery01-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "70px"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "margin-top": "16px"
            },
            ".items-row": {
              "row-gap": "30px",
              "@media (min-width: 768px)": {
                "margin": "0 -15px",
                "> [class*=\"col\"]": {
                  "padding-left": "15px",
                  "padding-right": "15px"
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "height": "100%",
              "overflow": "visible",
              "transition": "all 300ms ease",
              "&:hover": {
                "img": {
                  "transform": "scale(1.05)"
                }
              }
            },
            ".item-img": {
              "overflow": "hidden",
              "display": "flex",
              "flex-grow": "0",
              "flex-shrink": "0",
              "width": "100%",
              "box-shadow": "0 0 0 4px @borderColor",
              "img": {
                "transition": "all 300ms ease",
                "width": "100%",
                "max-width": "100%",
                "aspect-ratio": "(487 / 500)",
                "--bs-aspect-ratio": "(487 / 500)",
                "object-fit": "cover"
              }
            },
            ".item-content": {
              "flex-grow": "1",
              "display": "flex",
              "flex-direction": "column",
              "width": "100%",
              "padding": "25px 0 0",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#000000",
              "margin-bottom": "0"
            },
            ".mbr-text": {
              "color": "#000000",
              "padding-top": "5px"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "flex-wrap": "wrap"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "min-width": "50px",
              "min-height": "50px",
              "margin-right": "-5px",
              "margin-left": "-5px",
              "transition": "0.3s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "left": "50%",
                "top": "50%",
                "transform": "translate(-50%, -50%) scale(0)",
                "width": "100%",
                "height": "100%",
                "background": "@socialBgColor",
                "border-radius": "50%",
                "transition": "0.3s all"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.3s all",
                "font-size": "16px",
                "color": "@socialColor",
                "padding": "10px"
              },
              "&:hover": {
                ".mbr-iconfont": {
                  "color": "@socialHoverColor !important"
                },
                "&:before": {
                  "transform": "translate(-50%, -50%) scale(1)"
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "20px"
            }
          },
          "_name": "people04",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people4 range5\" group=\"People\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n\t\t<input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked=\"\">\n\t\t<input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n\t\t<header>Card</header>\n\t\t<input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked=\"\">\n\t\t<input type=\"checkbox\" name=\"showText\" title=\"Text\" checked=\"\">\n\t\t<input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#000000\" selected=\"\">\n\t\t<input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked=\"\">\n\t\t<input type=\"color\" title=\"Color\" name=\"socialColor\" value=\"#000000\" condition=\"showSocial\">\n\t\t<input type=\"color\" title=\"Bg Hover Color\" name=\"socialBgColor\" value=\"#000000\" condition=\"showSocial\">\n\t\t<input type=\"color\" title=\"Hover Color\" name=\"socialHoverColor\" value=\"#bff747\" condition=\"showSocial\">\n\t\t<input type=\"range\" title=\"Count\" name=\"socialCount\" min=\"1\" max=\"6\" step=\"1\" value=\"4\" condition=\"showSocial\">\n\t\t<input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" required=\"\">\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#fffff5\" selected=\"\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n\t</mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n\t\t\t<h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>\n\t\t\t\t\tThe Team\n\t\t\t\t</b></h4>\n\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\tUrna porttitor rhoncus dolor purus\n\t\t\t</h5>\n\t\t</div>\n\t\t<div class=\"row items-row align-items-stretch\">\n\t\t\t<div class=\"item features-image col-12 col-md-6 col-lg-3\">\n\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t<div class=\"item-img card-wrap\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/team9.webp\" alt=\"Mobirise Website Builder\">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"item-content\" mbr-if=\"showCardTitle || showText || showSocial || showButtons\">\n\t\t\t\t\t\t<h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>\n\t\t\t\t\t\t\t\tClinton King\n\t\t\t\t\t\t\t</b></h5>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t\tSenior Designer\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"social-list\" mbr-if=\"showSocial\">\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>0\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>1\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>2\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>3\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>4\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>5\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n\t\t\t\t\t\t\t\tRead More\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"item features-image col-12 col-md-6 col-lg-3\">\n\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t<div class=\"item-img card-wrap\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/team7.webp\" alt=\"Mobirise Website Builder\">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"item-content\" mbr-if=\"showCardTitle || showText || showSocial ||  showButtons\">\n\t\t\t\t\t\t<h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>\n\t\t\t\t\t\t\t\tCamilla Barnes\n\t\t\t\t\t\t\t</b></h5>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t\tCreative Director\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"social-list\" mbr-if=\"showSocial\">\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>0\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>1\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>2\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>3\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>4\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>5\">\n\t\t\t\t\t\t\t\t<span mbr-icon=\"\" class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n\t\t\t\t\t\t\t\tRead More\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"item features-image col-12 col-md-6 col-lg-3\">\n\