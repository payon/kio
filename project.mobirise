        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".image-wrapper": {
              "img": {
                "& when (@showBorder)": {
                  "border-radius": "2rem",
                  "padding": "5px",
                  "background-color": "@borderColor"
                }
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".row": {
              "align-items": "center",
              "@media (max-width: 991px)": {
                "flex-direction": "column-reverse",
                "gap": "90px"
              }
            },
            ".mbr-section-title": {
              "color": "#fdfde1"
            },
            ".text-wrapper": {
              "@media (max-width: 991px)": {
                "text-align": "center"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".mbr-menu, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".mbr-desc, .mbr-section-btn": {
              "color": "#fdfde1"
            }
          },
          "_name": "header01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"range5 header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"11\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Image</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#fdfde1\" selected condition=\"showBorder == true\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-8 col-lg-{{imageWidth}} image-wrapper\">\n                <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/team.webp\" alt=\"Mobirise Website Builder\">\n            </div>\n            <div class=\"col-12 col-lg col-md-12\">\n                <div class=\"text-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>✨ A web design company</b></h1>\n                    <p class=\"mbr-desc mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .mbr-section-btn\">\n                        We design websites that are visually striking, user-friendly, and built to deliver exceptional performance. Let’s create an unforgettable online experience for your audience.<br>\n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Your vision, our magic.<br>\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Start now<span class=\"mobi-mbri mobi-mbri-growing-chart mbr-iconfont mbr-iconfont-btn\"></span>\n                            </a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6dtyLnaN",
          "_anchor": "header01-1",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-box__top": {
              "flex-direction": "column-reverse",
              ".mbr-iconfont": {
                "font-size": "70px",
                "width": "auto"
              },
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "top"
            },
            ".item-mb": {
              "margin-bottom": "2rem",
              "@media (max-width: 767px)": {
                "margin-bottom": "1rem"
              }
            },
            ".card-box": {
              ".card-title": {
                "margin-top": "1.75rem",
                "margin-bottom": "1rem"
              },
              ".card-text": {
                "margin-bottom": "1.75rem",
                "line-height": "1.66"
              },
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "100%",
              ".item-footer": {
                "margin-left": "0",
                ".btn-primary": {
                  "border": "none",
                  "background-color": "unset !important",
                  "box-shadow": "none",
                  "margin": "0.2rem 0 0.2rem 0"
                },
                ".mbr-iconfont": {
                  "font-size": "28px",
                  "padding-left": "0"
                }
              }
            },
            ".item-wrapper": {
              "background": "@bgCard",
              "padding": "2rem !important",
              "height": "100%",
              "display": "flex",
              "flex-direction": "column",
              "border": "solid 2px @borderCard",
              "transition": "all 0.3s ease",
              ".btn": {
                "padding": "0",
                "margin": "0"
              },
              ".btn .mbr-iconfont-btn::before": {
                "background-color": "inherit"
              },
              "&:hover": {
                "background-color": "@bgCardHover",
                "box-shadow": "5px 5px 0 0 @borderCard",
                ".item-footer": {
                  ".mbr-iconfont": {
                    "transform": "translateX(1.25rem)"
                  }
                }
              }
            },
            ".mbr-iconfont": {
              "display": "inline-flex",
              "color": "#000000",
              "justify-content": "center",
              "align-items": "center",
              "margin": "0rem",
              "transition": "transform 0.3s ease"
            },
            ".icon-title": {
              "color": "#bff747"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".content-head": {
              "max-width": "856px"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#000000"
            },
            ".card-text, .item .mbr-section-btn": {
              "color": "#000000"
            }
