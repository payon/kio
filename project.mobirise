          "_name": "features01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"range5 features01\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"BG\" name=\"bgCard\" value=\"#fffff5\" selected>\n        <input type=\"color\" title=\"BG Hover\" name=\"bgCardHover\" value=\"#bff747\" selected>\n        <input type=\"color\" title=\"Border\" name=\"borderCard\" value=\"#000000\" selected>\n        <input type=\"checkbox\" title=\"Top Icon\" name=\"showTopIcon\" checked>\n        <input type=\"checkbox\" title=\"Bottom Icon\" name=\"showbottomIcons\" checked>\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"12\">1</option>\n            <option value=\"6\" selected>2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <div class=\"col-12 content-head\">\n                <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\"><b>✨ Web design <br>that wows</b></h2>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">Our company is the best solution\n                    in the event industry</h5>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"card-box__top\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Custom Creations</b></h5>\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showTopIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-sites mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .item .mbr-section-btn\">Transform your ideas into stunning websites that reflect your brand's unique personality and vision.\n                        </p>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showbottomIcons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://mobiri.se\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"card-box__top\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>E-Commerce Excellence</b></h5>\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showTopIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-photo mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .item .mbr-section-btn\">Launch your online store with our dynamic e-commerce solutions that drive sales and customer engagement.\n                        </p>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showbottomIcons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://mobiri.se\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"card-box__top\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>User Experience Magic</b></h5>\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showTopIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-edit mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .item .mbr-section-btn\">We optimize every pixel to ensure your users have a seamless and delightful experience on your site.<br>\n                        </p>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showbottomIcons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://mobiri.se\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"card-box__top\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Support Squad</b></h5>\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showTopIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-magic-stick mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .item .mbr-section-btn\">Our dedicated team is here to maintain and support your website, so you can focus on what you do best.<br>\n                        </p>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showbottomIcons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://mobiri.se\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6dwsh2vC",
          "_anchor": "features01-2",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "48px"
              },
              ".desc-wrapper": {
                ".mbr-desc": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "36px",
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "16px"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -32px",
              "justify-content": "center"
            },
            ".item": {
              "padding": "0 32px",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "margin-bottom": "28px"
              },
              ".item-wrapper": {
                "height": "100%",
                "border": "2px solid @border",
                "background-color": "@card",
                "transition": "all 0.3s ease-in-out",
                "overflow": "hidden !important",
                "&:hover, &:focus": {
                  "border": "2px solid @active",
                  "box-shadow": "4px 4px 0 0 @active"
                },
                ".item-wrap": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "overflow": "hidden",
                  "height": "100%",
                  ".item-content": {
                    "background-color": "#4b4b4b",
                    ".item-img": {
                      "height": "280px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "background-color": "@border",
                      "@media (max-width: 992px)": {
                        "height": "240px"
                      },
                      "@media (max-width: 576px)": {
                        "height": "200px"
                      },
                      "a": {
                        "height": "100%",
                        "width": "100%",
                        "img": {
                          "height": "100%",
                          "object-fit": "cover",
                          "border-radius": "0 !important"
                        }
                      }
                    },
                    ".text-wrap": {
                      "padding": "1.5rem",
                      "background-color": "@card",
                      "@media (max-width: 992px)": {
                        "padding": "16px"
                      },
                      ".item-desc": {
                        "margin-bottom": "8px",
                        "text-align": "center"
                      },
                      ".item-title": {
                        "margin-bottom": "8px"
                      },
                      ".item-text": {
                        "margin-bottom": "0"
                      }
                    }
                  },
                  ".icon-wrapper": {
                    "padding": "0 24px 24px 24px",
                    "@media (max-width: 992px)": {
                      "padding": "0 16px 16px 16px"
                    },
                    ".mbr-iconfont": {
                      "display": "inline-block",
                      "font-size": "24px",
                      "color": "@icon"
                    }
                  }
                }
              }
            },
            ".icon-wrapper": {
              "text-align": "right"
            },
            ".mbr-section-title, .item-title, .item-text": {
              "color": "#fdfde1",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fdfde1",
              "text-align": "center"
            },
            ".mbr-desc, .desc-wrapper": {
              "color": "#fdfde1",
              "text-align": "center"
            },
            ".item-desc": {
              "color": "#fdfde1"
            }
          },
          "_name": "features03",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 range5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showMainImage\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showCardDesc\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showLink\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#bff747\" name=\"icon\" condition=\"showLink\">\n        <input type=\"color\" title=\"BG\" value=\"#000000\" name=\"card\">\n        <input type=\"color\" title=\"Border\" value=\"#666666\" name=\"border\">\n        <input type=\"color\" title=\"Active Color\" value=\"#bff747\" name=\"active\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#060606\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#060606\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showText || showDesc\">\n                    <div class=\"desc-wrapper\">\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrapper\">THE ART OF DESIGN</p>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>We provide effective design solutions</b></h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Bringing ideas to life with innovative strategies and creative precision, tailored to meet\n                            your unique needs.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"item features-without-image col-12 col-md-8 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-content\">\n                            <div class=\"item-img\" mbr-if=\"showMainImage\">\n                                <a href=\"https://mobiri.se\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/gallery16.webp\" alt=\"Mobirise Website Builder\">\n                                </a>\n                            </div>\n                            <div class=\"text-wrap\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showCardDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    CREATIVE</p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>UI/UX\n                                        Design\n                                    </b></h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                    Focusing on user interface (UI) and user experience (UX) design to enhance the\n                                    usability and accessibility of digital products &amp; app.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"icon-wrapper\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-share mobi-mbri\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-8 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-content\">\n                            <div class=\"item-img\" mbr-if=\"showMainImage\">\n                                <a href=\"https://mobiri.se\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/gallery11.webp\" alt=\"Mobirise Website Builder\">\n                                </a>\n                            </div>\n                            <div class=\"text-wrap\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showCardDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    CREATIVE\n                                </p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>Graphic\n                                        Design\n                                    </b></h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                    Creating visual elements such as logos, branding materials, page layout techniques,\n                                    brochures, &amp; other marketing collateral.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"icon-wrapper\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-share mobi-mbri\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-8 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-content\">\n                            <div class=\"item-img\" mbr-if=\"showMainImage\">\n                                <a href=\"https://mobiri.se\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/gallery08.webp\" alt=\"Mobirise Website Builder\">\n                                </a>\n                            </div>\n                            <div class=\"text-wrap\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showCardDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    CREATIVE\n                                </p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>Web Design\n                                    </b></h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                    Designing and developing websites to ensure they are visually look and appealing,\n                                    user-friendly, and functional your website.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"icon-wrapper\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-share mobi-mbri\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6oNizjmf",
          "_anchor": "features03-h",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "border-radius": "2rem",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              ".content-wrap": {
                "width": "60%",
                "@media (max-width: 1199px)": {
                  "margin-bottom": "32px",
                  "width": "50%",
                  "padding-right": "0",
                  "padding-left": "0"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px",
                  "width": "100%"
                },
                "& when (@reverseContent)": {
                  "padding-right": "0",
                  "padding-left": "2rem",
                  "@media (max-width: 1199px)": {
                    "padding-left": "0"
                  }
                },
                ".text-wrapper": {
                  "@media (max-width: 992px)": {
                    "position": "static",
                    "padding": "0"
                  },
                  ".mbr-section-title": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "32px",
                    ".mbr-iconfont": {
                      "color": "#bff747"
                    },
                    "@media (max-width: 992px)": {
                      "margin-bottom": "24px"
                    }
                  },
                  ".mbr-text": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "0"
                  }
                }
              },
              ".panel-group": {
                "width": "40%",
                "@media (max-width: 1199px)": {
                  "width": "50%"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px",
                  "width": "100%",
                  "padding": "0"
                },
                ".card": {
                  "position": "relative",
                  "padding": "1.2rem",
                  "transition": "all 0.3s ease-in-out",
                  "overflow": "hidden",
                  "margin-top": "16px",
                  "border": "3px solid @border",
                  "background-color": "@card",
                  "backgraund-color": "show.bs.collapse #000000",
                  "@media (max-width: 992px)": {
                    "padding": "16px",
                    "width": "100%"
                  },
                  "&:first-child": {
                    "margin-top": "0"
                  },
                  ".card-header": {
                    "background-color": "transparent",
                    "border": "none",
                    "border-radius": "0",
                    "padding": "0",
                    ".panel-title": {
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".icon-wrapper": {
                        "width": "45px",
                        "height": "45px",
                        "min-width": "45px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "margin-left": "8px",
                        ".mbr-iconfont": {
                          "transition": "all 0.3s ease-in-out",
                          "font-size": "26px",
                          "color": "@icon"
                        }
                      },
                      "&:not(.collapsed)": {
                        ".icon-wrapper": {
                          "transform": "rotate(-45deg)"
                        }
                      }
                    }
                  },
                  ".panel-collapse": {
                    ".panel-body": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-top": "20px",
                      "@media (max-width: 992px)": {
                        "margin-top": "16px"
                      },
                      ".panel-text": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title, .mbr-text, .panel-title-edit, .panel-text": {
              "color": "#000000"
            }
          },
          "_name": "list01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 range5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n\t'mbr-fullscreen': fullScreen,\n\t'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<header>List</header>\n\t\t<select title=\"Amount\" name=\"cardAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" selected>\n\t\t<input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" selected>\n\t\t<input type=\"color\" title=\"BG\" value=\"#fffff5\" name=\"card\" selected>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n\t\t</fieldset>\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fffff5\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"content-wrapper row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n\t\t\t<div class=\"content-wrap\">\n\t\t\t\t<div class=\"text-wrapper \">\n\t\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .icon-wrapper\" mbr-if=\"showTitle\"><b>✨ Our high-quality\n\t\t\t\t\t\t\tworking\n\t\t\t\t\t\t\tprocesses</b></h2>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\tWe focus at every stage on effective communication and collaboration between the client and\n\t\t\t\t\t\tensuring that\n\t\t\t\t\t\tthe final design meets the client's objectives and expectations.\n\t\t\t\t\t</p>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style \" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">It is important to note that these are simplified steps, and the\n\t\t\t\t\t\tactual work process may vary\n\t\t\t\t\t\tdepending on\n\t\t\t\t\t\tthe complexity of the project.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n\t\t\t\t<div class=\"card\">\n\t\t\t\t\t<div class=\"card-header collapsed\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t<h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\"><b>01/ Project idea</b></h3>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tThe pro<i>c</i>ess starts with a detailed discussion with the client to understand their idea\n\t\t\t\t\t\t\t\t&amp; goals.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 1\">\n\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n\t\t\t\t\t\t\t<h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\"><b>02/ Brainstorming</b></h3>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tThe process starts with a detailed discussion with the client to understand their idea\n\t\t\t\t\t\t\t\t&amp; goals.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 2\">\n\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n\t\t\t\t\t\t\t<h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\"><b>03/ Launch</b></h3>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tThe process starts with a detailed discussion with the client to understand their idea\n\t\t\t\t\t\t\t\t&amp; goals.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 3\">\n\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">\n\t\t\t\t\t\t\t\t<b>How long does it take to build a website?</b>\n\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tThe timeline for website development depends on the project's scope and\n\t\t\t\t\t\t\t\tcomplexity. A basic website can take 4-6 weeks, while more complex sites can\n\t\t\t\t\t\t\t\ttake several months. We provide detailed timelines during the project planning\n\t\t\t\t\t\t\t\tphase.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 4\">\n\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">\n\t\t\t\t\t\t\t\t<b>Do you offer custom web development services?</b>\n\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tYes, we provide custom web development tailored to meet your specific needs and\n\t\t\t\t\t\t\t\trequirements. Whether you need a unique feature or a fully bespoke website, we\n\t\t\t\t\t\t\t\tcan help.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 5\">\n\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">\n\t\t\t\t\t\t\t\t<b>What technologies do you use for web development?</b>\n\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t<div class=\"icon-wrapper\">\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t<p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\tWe use a variety of technologies including HTML, CSS, JavaScript, PHP, Python,\n\t\t\t\t\t\t\t\tRuby on Rails, React, Angular, and more. We select the best technology stack\n\t\t\t\t\t\t\t\tbased on the project requirements.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "uw6efaloQc",
          "_anchor": "list01-d",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrapper": {
              "justify-content": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#bff747",
              "text-align": "center"
            }
          },
          "_name": "article01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article01 range5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"contentWidth\" title=\"Content Width\" min=\"6\" max=\"12\" step=\"1\" value=\"10\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col col-lg-{{contentWidth}}\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-text, .text-wrapper\">A web design company is a creative agency specializing in creating visually appealing, highly functional and user-friendly websites.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6dyawKPq",
          "_anchor": "article01-4",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            "@media (max-width: 992px)": {
              ".mbr-figure": {
                "margin-top": "1.5rem",
                "margin-bottom": "1.5rem"
              }
            },
            ".row": {
              "align-items": "center"
            },
            ".text-wrapper": {
              "@media (min-width: 992px)": {
                "padding": "0 2rem"
              },
              ".mbr-card-title": {
                "margin-bottom": "0.5rem"
              },
              ".py-4": {
                "padding-top": "1.5rem !important",
                "padding-bottom": "1.5rem !important"
              },
              ".pb-4": {
                "padding-bottom": "1.5rem !important"
              },
              ".pt-4": {
                "padding-top": "1.5rem !important"
              },
              ".mbr-figure iframe": {
                "width": "100%",
                "overflow": "hidden"
              }
            },
            ".app-video-wrapper": {
              "img": {
                "& when (@showBorder)": {
                  "background-color": "@borderColor",
                  "padding": "4px"
                }
              }
            },
            ".media-content, .mbr-figure": {
              "align-self": "center"
            },
            ".mbr-figure": {
              "overflow": "hidden"
            },
            ".card": {
              "background-color": "#000000",
              "& when (@showBorder)": {
                "background-color": "@borderColor",
                "padding": "4px"
              }
            },
            ".icon-title": {
              "color": "#bff747"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-number": {
              "color": "#bff747"
            },
            ".card-text, .item .mbr-section-btn": {
              "color": "#fdfde1"
            }
          },
          "_name": "video01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video01\" group=\"Image &amp; Video\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\t\t<input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline=\"\" name=\"videoWidth\" title=\"Video\" min=\"4\" max=\"8\" step=\"1\" value=\"8\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Card\" name=\"showCard\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n\t\t<input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked=\"\">\n\t\t<input type=\"color\" title=\"Color\" name=\"borderColor\" value=\"#000000\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" parallax=\"\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#fffff5\" selected=\"\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n\t\t</fieldset>\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<div class=\"title-wrapper\">\n\t\t\t\t\t<div class=\"row \">\n\t\t\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mb-4 col-12 col-lg-7\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>✨\n\t\t\t\t\t\t\t\tWe make your <br>business stand out</b></h2>\n\t\t\t\t\t\t<p class=\"mbr-text ms-auto mb-4 col-12 col-lg-5 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t\tWe work closely with our clients to know their objectives, target audience, unique needs,\n\t\t\t\t\t\t\tand practical\n\t\t\t\t\t\t\tdesign solutions.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-lg-{{videoWidth}}\">\n\t\t\t\t<div mbr-video=\"\" class=\"mbr-figure\">\n\t\t\t\t\t<iframe src=\"https://youtu.be/ikUv__ZenfQ\"></iframe>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-12 col-md-6 col-lg-4\" mbr-if=\"showCard\">\n\t\t\t\t<div class=\"text-wrapper\">\n\t\t\t\t\t<div class=\"card p-4 text-center\">\n\t\t\t\t\t\t<ul class=\"list-unstyled mb-0\">\n\t\t\t\t\t\t\t<li class=\"pb-4 border-bottom border-secondary\">\n\t\t\t\t\t\t\t\t<h3 class=\"mbr-card-title mbr-fonts-style mt-0 mbr-number\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\t<b>15+</b>\n\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tYears of experience\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li class=\"py-4 border-bottom border-secondary\">\n\t\t\t\t\t\t\t\t<h3 class=\"mbr-card-title mbr-fonts-style mt-0 mbr-number\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\t<b>120k</b>\n\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tSuccessful projects\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li class=\"pt-4\">\n\t\t\t\t\t\t\t\t<h3 class=\"mbr-card-title mbr-fonts-style mt-0 mbr-number\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-2\">\n\t\t\t\t\t\t\t\t\t<b>100%</b>\n\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\tClient satisfaction rate\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons=\"\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn\n\t\t\t\t\t\t\tmore</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "uw6dS5FhmZ",
          "_anchor": "video01-7",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "@media (min-width: 768px)": {
                  "padding": "0"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "(@cardWidth * 75px)",
              "max-width": "(@cardWidth * 75px)",
              "@media (max-width: 600px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex",
              "transition": "all 0.3s ease",
              "opacity": "0 !important",
              "@media (max-width: 767px)": {
                "opacity": "1 !important",
                "margin": "0",
                "transform": "translateX(0)"
              }
            },
            ".embla__button--prev": {
              "transform": "translateX(3rem)"
            },
            ".embla__button--next": {
              "transform": "translateX(-3rem)"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "30px",
              "border": "1px solid #fff",
              "border-radius": "50%",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "&:hover": {
                ".embla__button--next, .embla__button--prev": {
                  "transform": "translateX(0)",
                  "opacity": "1 !important"
                }
              },
              ".embla__button--next, .embla__button--prev": {
                "@media (max-width: 767px)": {
                  "opacity": "1 !important",
                  "margin": "0",
                  "transform": "translateX(0)"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            "& when (@draggable)": {
              ".embla__slide a": {
                "cursor": "grab"
              },
              ".embla__slide a:active": {
                "cursor": "grabbing"
              }
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#fdfde1",
              ".mbr-iconfont": {
                "color": "#bff747",
                "transition": "all 300ms ease"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#fdfde1"
            },
            ".mbr-box": {
              "color": "#ffffff"
            },
            ".slide-content": {
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap"
            },
            ".card-title": {
              "width": "100%",
              "margin-bottom": "0",
              "color": "#fffff5",
              "position": "relative",
              "transition": "all 300ms ease"
            },
            ".card-text": {
              "line-height": "1.66",
              "width": "100%",
              "color": "#fdfde1",
              "margin-bottom": "0",
              "position": "relative",
              "overflow": "hidden",
              "display": "-webkit-box",
              "-webkit-box-orient": "vertical",
              "-webkit-line-clamp": "2"
            },
            ".item-img": {
              "object-fit": "cover",
              "overflow": "hidden",
              "transition": "all 300ms ease",
              "& when (@cardBorder)": {
                "background-color": "@borderColor",
                "padding": "0.3rem"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "overflow": "hidden !important",
              "transition": "all 300ms ease",
              "height": "(@carouselHeight * 100px)",
              ".icon-wrapper": {
                "transition": "all 300ms ease"
              },
              ".card-box": {
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "padding": "1.5rem 0 1.5rem 1.5rem",
                "z-index": "11",
                ".mbr-iconfont": {
                  "font-size": "2rem",
                  "color": "#ffffff",
                  "transition": "all 300ms ease"
                }
              },
              ".card-text": {
                "font-size": "1.1rem"
              },
              "img": {
                "transition": "all 300ms ease",
                "object-fit": "cover"
              },
              "&::after": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background": "linear-gradient(to bottom, transparent, #000000)",
                "opacity": "0.6",
                "transition": "all 0.3s ease-in-out",
                "pointer-events": "none"
              },
              "&:hover": {
                ".icon-wrapper": {
                  "transform": "translateX(10px)"
                },
                "img": {
                  "transform": "scale3d(1.1, 1.1, 1.1)"
                },
                ".card-title, .mbr-iconfont": {
                  "color": "#bff747"
                }
              }
            },
            ".content-head": {
              "max-width": "856px"
            },
            ".card-title-1": {
              "color": "#fdfde1"
            },
            ".icon-wrapper": {
              "position": "relative",
              "overflow": "hidden"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla\" group=\"Gallery & Slider\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n\t\t<input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n\t\t<input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n\t\t<header>Carousel</header>\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n\t\t<input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n\t\t<input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n\t\t<input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n\t\t<input type=\"checkbox\" title=\"Arrows\" name=\"arrows\" checked>\n\t\t<header>Card</header>\n\t\t<input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" name=\"carouselHeight\" title=\"Height\" min=\"1\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" name=\"cardWidth\" title=\"Width\" min=\"1\" max=\"12\" step=\"1\" value=\"6\">\n\t\t<input type=\"checkbox\" name=\"cardBorder\" title=\"Border\" checked>\n\t\t<input type=\"color\" name=\"borderColor\" title=\"Color\" value=\"#fdfde1\" condition=\"cardBorder\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n\t\t\t<div class=\"col-12 content-head\">\n\t\t\t\t<div class=\"mb-4 text-center\">\n\n\t\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>Have a wide range of creative\n\t\t\t\t\t\t\tprojects ✨</b>\n\t\t\t\t\t</h3>\n\t\t\t\t</div>\n\n\n\t\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\tCarousel with Multiple Items\n\t\t\t\t</h5>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<div class=\"embla position-relative\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n\t\t\t\t\t<div class=\"embla__viewport\">\n\t\t\t\t\t\t<div class=\"embla__container\">\n\t\t\t\t\t\t\t<div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n\t\t\t\t\t\t\t\t<div class=\"slide-content\">\n\t\t\t\t\t\t\t\t\t<div class=\"item-img\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t<img class=\"card-img-bg w-100 h-100\" src=\"@PROJECT_PATH@/assets/images/gallery14.webp\" alt=\"Mobirise Website Builder\" title>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"card-box row\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"col pe-0\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<h3 class=\"card-title card-title-1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<b>Product Design</b>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\">Developing the look and feel of\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tphysical products,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\taesthetics, and functionality.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"col-auto icon-wrapper d-flex align-items-center overflow-hidden\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://mobiri.se\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n\t\t\t\t\t\t\t\t<div class=\"slide-content\">\n\t\t\t\t\t\t\t\t\t<div class=\"item-img\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t<img class=\"card-img-bg w-100 h-100\" src=\"@PROJECT_PATH@/assets/images/gallery15.webp\" alt=\"Mobirise Website Builder\" title>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"card-box row\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"col pe-0\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<h3 class=\"card-title card-title-1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<b>Logo and Branding