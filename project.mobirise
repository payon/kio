        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".icon-wrap": {
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px",
                "text-align": "left"
              },
              ".mbr-iconfont": {
                "display": "inline-flex",
                "width": "70px",
                "height": "70px",
                "color": "#bff474",
                "font-size": "70px",
                "@media (max-width: 992px)": {
                  "width": "48px",
                  "height": "48px",
                  "font-size": "48px"
                }
              },
              "text-align": "right"
            },
            ".items-wrap": {
              "justify-content": "center",
              "margin": "0 -10px",
              ".item": {
                "padding": "0 10px",
                "margin-bottom": "20px"
              }
            },
            ".item": {
              ".item-wrapper": {
                "height": "100%",
                "padding": "42px 28px",
                "background-color": "@card",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "@media (max-width: 992px)": {
                  "padding": "36px 24px"
                },
                ".card-box": {
                  ".item-price": {
                    "margin-bottom": "16px"
                  },
                  ".item-desc": {
                    "margin-bottom": "32px"
                  },
                  ".item-title": {
                    "margin-bottom": "32px"
                  },
                  ".list": {
                    "padding": "0",
                    "margin": "0 0 32px 0",
                    "list-style-type": "none",
                    ".item-wrap": {
                      "border-top": "2px solid @border",
                      "padding": "22px 0",
                      "&:first-child": {
                        "border-top": "none",
                        "padding-top": "0"
                      },
                      "&:last-child": {
                        "padding-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-price": {
              "color": "#fdfde1",
              "text-align": "center"
            },
            ".item-desc": {
              "color": "#bff747",
              "text-align": "center"
            },
            ".item-title, .mbr-section-btn": {
              "text-align": "center",
              "color": "#fdfde1"
            },
            ".list, .item-wrap": {
              "color": "#fdfde1"
            }
          },
          "_name": "pricing01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 range5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#bff747\" name=\"border\" condition=\"showList\" selected>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <input type=\"color\" title=\"BG\" value=\"#000000\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .icon-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Prices for services</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-2\">\n                <div class=\"icon-wrap\" mbr-if=\"showIcon\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-cash mobi-mbri\"></span>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrap\">\n\n\n            <div class=\"item features-without-image col-12 col-lg-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\" mbr-if=\"showCardTitle\"><b>\n                                Web Design Package</b></h4>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-5\" data-app-selector=\".item-desc\">\n                            $399</p>\n                        <p class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showDesc\">Web design packages\n                            offered a range of services and features to create websites</p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">Consultation &amp; Discovery</li>\n                            <li class=\"item-wrap\">Responsive Design</li>\n                            <li class=\"item-wrap\">E-commerce Integration</li>\n                            <li class=\"item-wrap\">Custom Web Design</li>\n                            <li class=\"item-wrap\">Testing and Quality Assurance</li>\n                        </ul>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Buy now\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-price mbr-fonts-style\" mbr-if=\"showCardTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\"><b>\n                                UX/UI Package</b></h4>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-5\" data-app-selector=\".item-desc\">$499</p>\n                        <p class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showDesc\">UX/UI package offered a\n                            set of services aimed at designing user-friendly UI/UX</p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">Information Architecture</li>\n                            <li class=\"item-wrap\">Wireframing &amp; Prototyping</li>\n                            <li class=\"item-wrap\">Usability Testing</li>\n                            <li class=\"item-wrap\">Visual Design &amp;</li>\n                            <li class=\"item-wrap\">User Interface (UI) Design</li>\n                        </ul>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Buy now\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-price mbr-fonts-style\" mbr-if=\"showCardTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\"><b>\n                                Branding Package</b></h4>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-5\" data-app-selector=\".item-desc\">$459</p>\n                        <p class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showDesc\">Branding package\n                            typically includes a comprehensive set of brand's identity</p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">Brand Guidelines</li>\n                            <li class=\"item-wrap\">Stationery &amp; Website Design</li>\n                            <li class=\"item-wrap\">E-commerce Integration</li>\n                            <li class=\"item-wrap\">Social Media Assets</li>\n                            <li class=\"item-wrap\">Signage &amp; Packaging Design</li>\n                        </ul>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Buy now\n                        </a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6er76uIR",
          "_anchor": "pricing01-e",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 23px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 12px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 23px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 12px"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "border-radius": "32px",
              "padding": "1.5rem",
              "@media (max-width: 768px)": {
                "display": "block",
                "padding": "0.5rem"
              },
              ".title-wrapper": {
                "width": "50%",
                "margin-right": "32px",
                "& when (@reverseContent)": {
                  "margin-right": "0",
                  "margin-left": "32px"
                },
                "@media (max-width: 768px)": {
                  "width": "100%",
                  "padding": "24px",
                  "margin": "0"
                },
                "@media (max-width: 576px)": {
                  "padding": "0px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "1.5rem"
                },
                ".mbr-social-likns .mbr-iconfont": {
                  "border-radius": "50px",
                  "border": "1px solid #fdfde1",
                  "color": "#fdfde1",
                  "transition": "all 300ms ease",
                  "&:hover": {
                    "color": "#bff747",
                    "border-color": "#bff747"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              },
              ".mbr-form": {
                "width": "40%",
                "@media (max-width: 992px)": {
                  "width": "50%"
                },
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                ".form-wrap": {
                  "width": "100%",
                  "@media (max-width: 768px)": {
                    "padding": "24px"
                  },
                  "@media (max-width: 576px)": {
                    "padding": "0px"
                  },
                  ".dragArea.row": {
                    ".mbr-section-title": {
                      "margin-bottom": "20px !important"
                    },
                    ".mbr-text": {
                      "margin-bottom": "20px !important"
                    },
                    ".form-group": {
                      "margin-bottom": "16px !important",
                      ".form-control": {
                        "color": "@text",
                        "padding": "1.3rem 1.5rem",
                        "font-weight": "700",
                        "box-shadow": "none",
                        "border-radius": "3rem !important",
                        "border": "1px solid @border !important",
                        "background-color": "@inputBg",
                        "transition": "all 300ms ease",
                        "&:hover, &:focus": {
                          "border": "1px solid @borderActive !important",
                          "box-shadow": "none"
                        },
                        "&::placeholder": {
                          "color": "@border"
                        }
                      },
                      "textarea.form-control": {
                        "min-height": "150px",
                        "border-radius": "1.3rem !important"
                      },
                      ".form-check": {
                        "padding-left": "1.7em",
                        "margin-bottom": "10px",
                        ".form-check-input": {
                          "background-color": "@border",
                          "border-color": "@border"
                        }
                      }
                    },
                    ".mbr-section-btn": {
                      "margin-top": "6px",
                      ".btn": {
                        "width": "100%",
                        "padding": "1.25rem 1.5rem"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-form .form-conrol": {
              "color": "@text"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#fdfde1"
            },
            "label": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".card-contacts": {
              "color": "#bff747"
            }
          },
          "_name": "form01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 range5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked=\"\">\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\" checked=\"\">\n        <input type=\"range\" title=\"Count\" name=\"iconCount\" min=\"0\" max=\"5\" step=\"1\" value=\"4\" condition=\"showSocialIcons\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Text\" value=\"#fdfde1\" name=\"text\" selected=\"\">\n        <input type=\"color\" title=\"Input BG\" value=\"#000000\" name=\"inputBg\" selected=\"\">\n        <input type=\"color\" title=\"Input Border\" value=\"#fdfde1\" name=\"border\" selected=\"\">\n        <input type=\"color\" title=\"Input Border Active\" value=\"#bff747\" name=\"borderActive\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>✨ Let's start a project together</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            We work closely with our clients to understand their objectives, target audience, and unique\n                            needs. We use our creative skills to translate these requirements and practical design\n                            solutions.<br>\n                        </p><br>\n                        <p class=\"card-contacts mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Give us a call:<br>\n                            <a href=\"https://mobiri.se\" class=\"text-secondary\">+011 222 343 56</a><br>\n                        </p>\n                        <p class=\"card-contacts mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Send us an email:<br><a href=\"https://mobiri.se\" class=\"text-secondary\">admin@expertm5.com</a>\n                        </p>\n                        <div class=\"mbr-social-likns align-left mb-0\" data-counters=\"false\" mbr-if=\"iconCount > 0 &amp;&amp; showSocialIcons\">\n                            <a class=\"iconfont-wrapper ms-0\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 0\">\n                                <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 1\">\n                                <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 2\">\n                                <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 3\">\n                                <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-youtube socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 4\">\n                                <span mbr-icon=\"\" class=\"p-2 mbr-iconfont socicon-pinterest socicon\"></span>\n                            </a>\n                        </div>\n                    </div>\n                    <div mbr-form=\"\" class=\"ms-auto mbr-form\">\n                        <!--Formbuilder Form-->\n                        <form action=\"\" name=\"range5\" method=\"POST\" class=\"mbr-form form-with-styler form-wrap\" data-verified=\"\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Thanks for\n                                    filling out the form!</div>\n                                <div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">\n                                    Oops...!\n                                    some problem! </div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                                    <h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\">Send us a\n                                        message</h3>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n                                    <input type=\"text\" name=\"text\" placeholder=\"Your name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n                                </div>\n                                <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"email\" name=\"email\" placeholder=\"Your email address\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value=\"\">\n                                </div>\n                                <div data-for=\"tel\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"tel\" name=\"tel\" placeholder=\"Your phone number\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value=\"\">\n                                </div>\n                                <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <textarea name=\"textarea\" placeholder=\"Write your message here...\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\"></textarea>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n                                    <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 btn btn-primary\">Send Now</a>\n                                </div>\n                            </div>\n                        </form><!--Formbuilder Form-->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6es0Lv9W",
          "_anchor": "form01-f",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".media-container-row .mbr-text": {
              "color": "#fdfde1"
            }
          },
          "_name": "footer02",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2030 Mobirise - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6esArSSY",
          "_anchor": "footer02-g",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}